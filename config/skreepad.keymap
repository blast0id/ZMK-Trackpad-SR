#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4    &kp F5     &kp F6     &kp N1                  &kp N6    &kp F7  &kp F8  &kp F9     &kp F10  &kp F11   &kp F12
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4     &kp N5     &kp N2                  &kp N7    &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R      &kp T      &kp N3      &kp C_MUTE  &kp N8    &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S   &kp D     &kp F      &kp G      &kp HOME                &kp PGUP  &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V      &kp B      &kp END                 &kp PGDN  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                   &kp UP  &kp DOWN                                                                          &kp LEFT   &kp RIGHT  
                                     &kp LCTRL  &kp SPACE  &kp LALT                &kp DEL  &kp RET  &kp RGUI
                                     &kp BSPC   &kp DEL    &mo 1                   &mo 2    &kp RET  &kp SPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bluetooth_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans                                                                        &trans  &trans
                                &bt BT_CLR      &bt BT_NXT  &trans            &trans  &trans  &trans
                                &bt BT_CLR_ALL  &trans      &trans            &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            bindings = <
&kp F13  &kp F14  &kp F15  &kp F16  &kp F17  &kp F18  &trans            &trans           &kp F19          &kp F20          &kp F21          &kp F22          &kp F23          &kp F24
&trans   &trans   &trans   &trans   &trans   &trans   &trans            &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans    &trans  &trans           &trans           &trans           &trans           &trans           &trans           &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans            &trans           &trans           &trans           &trans           &trans           &trans           &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans            &trans           &trans           &trans           &trans           &trans           &trans           &trans
                  &trans   &trans                                                                                          &trans           &trans
                                    &trans   &trans   &trans            &trans           &kp HOME         &kp PAGE_UP
                                    &trans   &trans   &trans            &trans           &kp END          &kp PAGE_DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans   &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp Q   &kp W   &kp F    &kp P   &kp G   &trans          &trans  &trans  &kp J   &kp L   &kp U   &kp Y   &trans  &trans
&trans  &kp A   &kp R   &kp S    &kp T   &kp D   &trans                  &trans  &kp H   &kp N   &kp E   &kp I   &kp O   &trans
&trans  &kp Z   &kp X   &kp C    &kp V   &kp B   &trans                  &trans  &kp K   &kp M   &trans  &trans  &trans  &trans
                &trans  &trans                                                                   &trans  &trans
                                 &trans  &trans  &trans                  &trans  &trans  &trans
                                 &trans  &trans  &trans                  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
