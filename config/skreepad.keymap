#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";

        toggle_colemak {
            bindings = <&tog 3>;
            key-positions = <7 84>;
        };

        toggle_function {
            bindings = <&tog 2>;
            key-positions = <7 83>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4    &kp F5    &kp F6     &kp GRAVE                       &kp KP_NLCK        &kp F7    &kp F8     &kp F9     &kp F10    &kp F11   &kp F12
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5     &kp LEFT_BRACKET                &kp RIGHT_BRACKET  &kp N6    &kp N7     &kp N8     &kp N9     &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T      &kp PLUS            &kp C_MUTE  &kp MINUS          &kp Y     &kp U      &kp I      &kp O      &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S   &kp D     &kp F     &kp G      &kp HOME                        &kp PG_UP          &kp H     &kp J      &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B      &kp END                         &kp PG_DN          &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH  &kp RET
                   &kp UP  &kp DOWN                                                                                               &kp LEFT   &kp RIGHT
                                     &kp DEL   &kp LCTRL  &kp LALT                        &kp DEL            &kp UP    &kp RGUI
                                     &kp BSPC  &kp SPACE  &mo 1                           &mo 2              &kp DOWN  &kp SPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bluetooth_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans                                                                        &trans  &trans
                                &bt BT_CLR      &bt BT_NXT  &trans            &trans  &trans  &trans
                                &bt BT_CLR_ALL  &trans      &trans            &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            bindings = <
&kp F13  &kp F14  &kp F15  &kp F16  &kp F17  &kp F18  &trans            &trans           &kp F19          &kp F20          &kp F21          &kp F22          &kp F23          &kp F24
&trans   &trans   &trans   &trans   &trans   &trans   &trans            &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans    &trans  &trans           &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans           &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans            &trans           &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans           &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans            &trans           &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans           &trans
                  &trans   &trans                                                                                          &kp KP_NUMBER_0  &kp KP_ENTER
                                    &trans   &trans   &trans            &trans           &kp HOME         &kp PAGE_UP
                                    &trans   &trans   &trans            &trans           &kp END          &kp PAGE_DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp Q   &kp W   &kp F   &kp P   &kp G   &trans    &trans  &trans  &kp J   &kp L   &kp U   &kp Y   &trans  &trans
&trans  &kp A   &kp R   &kp S   &kp T   &kp D   &trans            &trans  &kp H   &kp N   &kp E   &kp I   &kp O   &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B   &trans            &trans  &kp K   &kp M   &trans  &trans  &trans  &trans
                &trans  &trans                                                            &trans  &trans
                                &trans  &trans  &trans            &trans  &trans  &trans
                                &trans  &trans  &trans            &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
